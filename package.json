{
  "name": "agent-memory-tools",
  "version": "0.1.0",
  "description": "Validate and maintain agent memory files against architecture rules",
  "type": "module",
  "main": "dist/index.cjs",
  "bin": {
    "agent-memory-tools": "dist/index.cjs",
    "lint-memories": "bin/lint-memories"
  },
  "files": [
    "dist/",
    "bin/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["memory", "agent", "lint", "validation"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
